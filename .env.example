# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (Vercel). Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do app (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://app.direitaconecta.com.br

# Resend (e-mails de proposta e mensagem)
RESEND_API_KEY=
EMAIL_FROM="Direita Conecta br <avisos@direitaconecta.com.br>"

# Segredo do agendamento (GitHub Actions chama /api/cron)
CRON_SECRET=

# Origens que podem enviar o formulário da landing para /api/cadastro (separadas por vírgula)
CADASTRO_ORIGENS=https://direitaconectabr.pages.dev,https://direitaconecta.com.br

# Link do grupo de membros no WhatsApp
NEXT_PUBLIC_GRUPO_WHATSAPP=https://chat.whatsapp.com/IoQVYreiI5v8LToOQzilNF
